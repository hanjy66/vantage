# ============================================================
# Vantage — 环境变量示例
# 复制为 .env 后填入真实 key（.env 已被 .gitignore，不会泄露）
# ============================================================

# --- 写作 / 研究 / 升级模型：DeepSeek（OpenAI 兼容协议）---
# OPENAI_API_KEY 填 DeepSeek 的 key；OPENAI_BASE_URL 指向 DeepSeek 网关
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# --- 审计 / 图表抽取 / 架构抽取 / 视觉：Moonshot (Kimi) ---
# 与写作模型不同源，构成「跨模型校验」（DeepSeek 写 · Kimi 审）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# --- 中文搜索 + Embedding 语义召回：智谱 GLM ---
ZHIPUAI_API_KEY=

# --- 主搜索引擎：Tavily ---
TAVILY_API_KEY=

# --- 可观测性：LangSmith（可选，开启后自动上报 trace）---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vantage
LANGSMITH_TRACING=false

# --- 可选 / 备用提供方 ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- 本地存储路径（可选，留空用默认）---
# KG_DIR=data/kg
# OBSIDIAN_VAULT_DIR=data/obsidian_vault

# 部署到 Open Agent Platform 时才需要；本地开发保持 false
GET_API_KEYS_FROM_CONFIG=false
